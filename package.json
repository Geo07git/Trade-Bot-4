{
  "name": "gs-trade-bot",
  "productName": "GS-Trade-Bot",
  "description": "GS Trading Bot Desktop Application",
  "author": "Georgeo Ciutan",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\"",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder --win nsis",
    "build:exe": "npm run build && electron-builder --win nsis",
    "build:desktop": "npm run build && electron-builder --win nsis portable",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "build:apk": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "build:apk:release": "npm run build && cap sync android && cd android && ./gradlew assembleRelease",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-electron android",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.gs.tradebot",
    "productName": "GS-Trade-Bot",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tensorflow/tfjs": "^4.22.0",
    "@vitejs/plugin-react": "^5.0.4",
    "binance-api-node": "^0.13.10",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
